{
  "name": "zeiterfassung",
  "productName": "Zeiterfassung",
  "version": "0.5.10",
  "description": "Zeiterfassung und Rechnungsübersicht für Fabio Canetg GmbH",
  "author": "Fabio Canetg GmbH",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "test": "node tools/test-calc.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ch.fabiocanetg.zeiterfassung",
    "productName": "Zeiterfassung",
    "files": [
      "main.js",
      "preload.js",
      "invoice.js",
      "src/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zeiterfassung",
      "artifactName": "Zeiterfassung-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  },
  "dependencies": {
    "swissqrbill": "^4.4.2"
  }
}
